# Railway에 배포한 AnythingLLM 주소 (끝에 슬래시 없이)
ANYTHINGLLM_BASE_URL=https://your-anythingllm.up.railway.app

# AnythingLLM 관리자 화면 > Settings > API Keys 에서 발급
ANYTHINGLLM_API_KEY=여기에_API_키_입력

# AnythingLLM 워크스페이스 화면 URL에 보이는 slug (예: 단풍-관찰-워크스페이스)
ANYTHINGLLM_WORKSPACE_SLUG=여기에_워크스페이스_slug_입력

# Railway가 자동으로 지정해주므로 로컬 테스트용으로만 사용
PORT=3000

# 학생 대화 기록(질문+답변)을 모아서 엑셀/워드로 내려받을 때 쓰는 비밀 키.
# 연구자만 아는 값으로 정해서 /admin.html 페이지에 입력하면 전체 학생 기록을 받을 수 있습니다.
ADMIN_KEY=여기에_임의의_비밀키_입력

# 대화 기록(SQLite DB 파일 등)을 저장할 폴더. Railway에서는 이 경로에 Volume을 연결해야
# 재배포 후에도 기록이 사라지지 않습니다. (비워두면 기본값 "data" 사용)
DATA_DIR=data

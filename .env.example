# Railway에 배포한 AnythingLLM 주소 (끝에 슬래시 없이)
ANYTHINGLLM_BASE_URL=https://your-anythingllm.up.railway.app

# AnythingLLM 관리자 화면 > Settings > API Keys 에서 발급
ANYTHINGLLM_API_KEY=여기에_API_키_입력

# AnythingLLM 워크스페이스 화면 URL에 보이는 slug (예: 단풍-관찰-워크스페이스)
ANYTHINGLLM_WORKSPACE_SLUG=여기에_워크스페이스_slug_입력

# Railway가 자동으로 지정해주므로 로컬 테스트용으로만 사용
PORT=3000

# 학생 대화 기록(질문+답변)을 모아서 엑셀/워드로 내려받을 때 쓰는 비밀 키.
# 연구자만 아는 값으로 정해서 /admin.html 페이지에 입력하면 전체 학생 기록을 받을 수 있습니다.
ADMIN_KEY=여기에_임의의_비밀키_입력

# 대화 기록(SQLite DB 파일 등)을 저장할 폴더. Railway에서는 이 경로에 Volume을 연결해야
# 재배포 후에도 기록이 사라지지 않습니다. (비워두면 기본값 "data" 사용)
DATA_DIR=data

# AnythingLLM의 Agent Flow("교육학 안내 조회", "학생 관찰 이력 조회")가 우리 서버의
# /api/tools/* 엔드포인트를 호출할 때 보내는 공유 비밀키. 아무 값이나 임의의 긴 문자열로
# 정하고, AnythingLLM Agent Flow의 API Call 블록 Header에 "X-Tool-Key: 이값" 을 그대로
# 넣어주면 됩니다.
TOOL_API_KEY=여기에_임의의_비밀키_입력

# ---- 3모드 개편: 모드별 AnythingLLM 워크스페이스 slug ----
# 관찰력 진단 모드(채점 전용), 오프로딩 진단 모드(일반 챗봇에 가깝게), AI Agent 과제 지원 모드(Agent Flow 사용)
WS_SLUG_ASSESS=autumn-assess
WS_SLUG_OFFLOAD=autumn-offload
WS_SLUG_SUPPORT=autumn-support
# 채점을 별도 워크스페이스로 하고 싶을 때만 지정. 비우면 WS_SLUG_ASSESS를 씀.
WS_SLUG_JUDGE=

# 한 모드의 제한 시간(초). 기본 600(10분). 점검 때는 60처럼 줄여서 시험.
SESSION_SECONDS=600
# 1이면 탭 1,2 진단이 없어도 탭 3을 연다(점검용). 수업 때는 비워 둔다.
UNLOCK_ALL=
